{
  "backend": "rclone",
  "rclone_remote": "onedrive",
  "remote_base_folder": "iPhone Backup",
  "organize_by": "date",
  "source_subdir": "DCIM",
  "poll_interval_seconds": 5,
  "include_extensions": [
    ".jpg", ".jpeg", ".png", ".heic", ".heif", ".gif", ".tiff", ".dng",
    ".mov", ".mp4", ".m4v", ".avi"
  ],

  "_comment_graph_backend": "To use the built-in Microsoft Graph uploader instead of rclone, set backend to 'graph' and fill these:",
  "client_id": "",
  "tenant": "consumers",
  "chunk_size_mib": 10
}
